# Public client values, NOT service/secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Optional read-only AI. No automatic mock fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_REQUESTS_PER_HOUR=10
AI_MAX_OUTPUT_TOKENS=1500
AI_PROMPT_VERSION=inventory-insights-v1
# Admin tooling ONLY; never used by the running application.
DATABASE_TEST_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
