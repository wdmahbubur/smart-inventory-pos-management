# Public client values, NOT service/secret keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://127.0.0.1:3000
# Optional read-only AI. No automatic mock fallback.
# OpenRouter is the default production provider; keep the API key server-side.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=apodex/apodex-1.1-mini:free
# Gemini remains an explicitly supported alternative.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
AI_REQUEST_TIMEOUT_MS=50000
AI_MAX_REQUESTS_PER_HOUR=10
AI_MAX_OUTPUT_TOKENS=9000
AI_PROMPT_VERSION=inventory-predictions-v3
# Admin tooling ONLY; never used by the running application.
DATABASE_TEST_URL=postgresql://postgres:postgres@127.0.0.1:54322/smart_inventory_test
